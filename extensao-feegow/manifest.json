{
  "manifest_version": 3,
  "name": "Éclairé · Busca Feegow",
  "version": "0.6.0",
  "description": "Preenche a Busca rápida do Feegow com o nome conferido no Éclairé.",
  "key": "",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://app.feegow.com/*",
    "https://clinic.feegow.com/*",
    "https://sistema-eclaire-clinico.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://sistema-eclaire-clinico.onrender.com/*"
    ]
  },
  "action": {
    "default_title": "Enviar laudo ao Feegow",
    "default_popup": "popup.html"
  }
}
